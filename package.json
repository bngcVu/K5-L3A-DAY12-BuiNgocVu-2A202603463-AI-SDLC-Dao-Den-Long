{
  "name": "dao-den-long",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Đảo Đèn Lồng - game 3D (Three.js) với sim tất định chạy headless",
  "scripts": {
    "start": "node server.js",
    "headless": "node src/headless.js",
    "test": "node --test tests/unit/*.test.js",
    "check": "bash scripts/check.sh",
    "bench": "node bench/bench.js --seed 42 --duration 30 --out bench.json",
    "soak": "node src/soak.js --seed 7 --nights 10 --out soak.json",
    "build:web": "node scripts/build-web.mjs"
  },
  "dependencies": {
    "three": "0.160.0"
  }
}
